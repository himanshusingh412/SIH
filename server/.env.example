# SIH 2026 AI Content Transformation Engine — Environment Variables

PORT=5001
NODE_ENV=development
# Neon PostgreSQL Database Connection String (Server-side ONLY)
DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# AI Provider Configuration (Gemini — used for Knowledge Agent + Prototype Assistant)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash-lite
DEMO_MODE=false

# --- AI resilience / rate-limit controls -------------------------------------
# Fallback chain: preferred -> Gemini -> Bedrock -> OpenAI -> offline engine.
# Set to false to fail loudly instead of degrading (not recommended for demos).
AI_ALLOW_FALLBACK=true
# Minimum spacing between upstream Gemini calls (ms). Raise if you keep seeing 429s.
GEMINI_MIN_INTERVAL_MS=1100
# Upper bound the adaptive backoff can grow to (ms).
GEMINI_MAX_INTERVAL_MS=15000
# Retries per Gemini call before the chain moves to the next provider.
GEMINI_MAX_RETRIES=3
GEMINI_MAX_BACKOFF_MS=8000
# Wall-clock budget for one ingest/generate request (ms). Keep under the
# serverless function maxDuration (vercel.json sets 60s).
AI_PIPELINE_BUDGET_MS=50000
AI_PROVIDER_CALL_BUDGET_MS=25000
# Skip a rate-limited provider when its cooldown is longer than this (ms).
AI_MAX_COOLDOWN_WAIT_MS=5000
