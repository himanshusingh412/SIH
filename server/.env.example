# SIH 2026 AI Content Transformation Engine — Environment Variables

PORT=5001
NODE_ENV=development
# Neon PostgreSQL Database Connection String (Server-side ONLY)
DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# AI Provider Configuration (Primary — Gemini)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
DEMO_MODE=false

# OpenAI Configuration (Optional — for Prototype Assistant & fallback provider)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
