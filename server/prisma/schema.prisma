generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  role      String    @default("OPERATOR")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
  resumes   Resume[]
}

model Project {
  id               String            @id @default(uuid())
  userId           String?
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  status           String            @default("DRAFT") // DRAFT, INGESTED, GENERATED, VALIDATED
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sourceDocuments  SourceDocument[]
  contentSpines    ContentSpine[]
  outputs          Output[]
  validationResults ValidationResult[]
  generationJobs   GenerationJob[]
  audienceProfiles AudienceProfile[]
  voiceGenerations VoiceGeneration[]
  transcripts      Transcript[]
  musicGenerations MusicGeneration[]
  sfxGenerations   SFXGeneration[]
  dubbingProjects  DubbingProject[]
  mediaAssets      MediaAsset[]
  agents           Agent[]
  resumes          Resume[]

  @@index([userId])
  @@index([status])
}

model SourceDocument {
  id               String            @id @default(uuid())
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename         String
  fileType         String
  inputCategory    String            // PDF, REPORT, ARTICLE, RESEARCH_PAPER, THREAT_INTEL, POLICY, IMAGE, VIDEO, PROMPT, AUDIO
  rawText          String
  fileSize         Int?              @default(0)
  pageCount        Int?              @default(1)
  createdAt        DateTime          @default(now())
  sourceReferences SourceReference[]

  @@index([projectId])
}

model ContentSpine {
  id            String    @id @default(uuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version       Int       @default(1)
  summary       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  facts         Fact[]
  entities      Entity[]

  @@index([projectId])
}

model Fact {
  id             String          @id @default(uuid())
  contentSpineId String
  contentSpine   ContentSpine    @relation(fields: [contentSpineId], references: [id], onDelete: Cascade)
  factKey        String
  factValue      String
  category       String          // DATE, NUMBER, PERSON, ORGANIZATION, LOCATION, CLAIM, RISK, RECOMMENDATION
  isLocked       Boolean         @default(true)
  confidence     Float           @default(1.0)
  createdAt      DateTime        @default(now())
  references     SourceReference[]

  @@index([contentSpineId])
  @@index([category])
}

model Entity {
  id             String          @id @default(uuid())
  contentSpineId String
  contentSpine   ContentSpine    @relation(fields: [contentSpineId], references: [id], onDelete: Cascade)
  name           String
  type           String          // PERSON, ORGANIZATION, LOCATION, TECHNOLOGY, EVENT
  confidence     Float           @default(1.0)
  createdAt      DateTime        @default(now())
  references     SourceReference[]

  @@index([contentSpineId])
  @@index([type])
}

model SourceReference {
  id               String          @id @default(uuid())
  sourceDocumentId String
  sourceDocument   SourceDocument  @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  factId           String?
  fact             Fact?           @relation(fields: [factId], references: [id], onDelete: SetNull)
  entityId         String?
  entity           Entity?         @relation(fields: [entityId], references: [id], onDelete: SetNull)
  snippetText      String
  pageNumber       Int?            @default(1)
  startCharIndex   Int?            @default(0)
  endCharIndex     Int?            @default(0)

  @@index([sourceDocumentId])
  @@index([factId])
  @@index([entityId])
}

model Output {
  id                String            @id @default(uuid())
  projectId         String
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outputType        String            // EXECUTIVE_SUMMARY, LINKEDIN_POST, X_THREAD, ADVISORY, PRESENTATION, INFOGRAPHIC, VIDEO_PACKAGE
  audienceProfileId String?
  audienceProfile   AudienceProfile?  @relation(fields: [audienceProfileId], references: [id], onDelete: SetNull)
  currentVersionId  String?
  isConsistent      Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  versions          OutputVersion[]
  voiceGenerations  VoiceGeneration[]

  @@index([projectId])
  @@index([outputType])
}

model OutputVersion {
  id            String   @id @default(uuid())
  outputId      String
  output        Output   @relation(fields: [outputId], references: [id], onDelete: Cascade)
  version       Int      @default(1)
  title         String
  content       String   // Stringified structured JSON or markdown text
  createdReason String   @default("INITIAL_GENERATION") // INITIAL_GENERATION, MANUAL_EDIT, AUTO_CORRECTION, RE_GENERATION
  createdAt     DateTime @default(now())

  @@index([outputId])
}

model ValidationResult {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  consistencyScore Float    @default(100.0)
  passed           Boolean  @default(true)
  issuesFound      String   // JSON stringified envelope containing _summary and issues list
  autoCorrected    Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([projectId])
}

model GenerationJob {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  outputTypes  String    // JSON stringified array of target output types
  errorMessage String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([projectId])
  @@index([status])
}

model AudienceProfile {
  id          String    @id @default(uuid())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name        String    // EXECUTIVE, TECHNICAL, GOVERNMENT, PUBLIC
  tone        String    @default("FORMAL")
  detailLevel String    @default("HIGH")
  targetGoal  String?
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  outputs     Output[]

  @@index([projectId])
}

// ----------------------------------------------------
// MULTIMODAL & CREATIVE STUDIO EXTENDED MODELS
// ----------------------------------------------------

model Voice {
  id               String            @id @default(uuid())
  voiceId          String            @unique // Provider voice ID (e.g., ElevenLabs ID)
  name             String
  provider         String            @default("elevenlabs") // elevenlabs, mock
  category         String            @default("premade") // premade, cloned, professional
  language         String            @default("en-US")
  gender           String            @default("neutral")
  previewUrl       String?
  description      String?
  isCloned         Boolean           @default(false)
  consentConfirmed Boolean           @default(false)
  createdAt        DateTime          @default(now())
  voiceGenerations VoiceGeneration[]
}

model VoiceGeneration {
  id             String      @id @default(uuid())
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outputId       String?
  output         Output?     @relation(fields: [outputId], references: [id], onDelete: SetNull)
  voiceId        String
  voice          Voice       @relation(fields: [voiceId], references: [id], onDelete: Cascade)
  text           String
  audioUrl       String
  durationSeconds Float      @default(0.0)
  stability      Float       @default(0.5)
  similarity     Float       @default(0.75)
  style          Float       @default(0.0)
  status         String      @default("COMPLETED") // PENDING, COMPLETED, FAILED
  createdAt      DateTime    @default(now())

  @@index([projectId])
  @@index([voiceId])
}

model Transcript {
  id          String              @id @default(uuid())
  projectId   String
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename    String
  language    String              @default("en")
  fullText    String
  duration    Float               @default(0.0)
  status      String              @default("COMPLETED")
  createdAt   DateTime            @default(now())
  segments    TranscriptSegment[]

  @@index([projectId])
}

model TranscriptSegment {
  id           String     @id @default(uuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  speaker      String     @default("Speaker 1")
  startTime    Float
  endTime      Float
  text         String

  @@index([transcriptId])
}

model MusicGeneration {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prompt         String
  genre          String   @default("ambient")
  mood           String   @default("calm")
  durationSeconds Int     @default(30)
  audioUrl       String
  createdAt      DateTime @default(now())

  @@index([projectId])
}

model SFXGeneration {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prompt         String
  category       String   @default("alert")
  audioUrl       String
  createdAt      DateTime @default(now())

  @@index([projectId])
}

model DubbingProject {
  id             String         @id @default(uuid())
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceLanguage String         @default("en")
  targetLanguage String
  status         String         @default("COMPLETED")
  createdAt      DateTime       @default(now())
  tracks         DubbingTrack[]

  @@index([projectId])
}

model DubbingTrack {
  id               String         @id @default(uuid())
  dubbingProjectId String
  dubbingProject   DubbingProject @relation(fields: [dubbingProjectId], references: [id], onDelete: Cascade)
  originalText     String
  translatedText   String
  audioUrl         String
  factLocksPassed  Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@index([dubbingProjectId])
}

model MediaAsset {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assetType       String   // AUDIO, VIDEO, IMAGE, TRANSCRIPT, PRESENTATION
  filename        String
  mimeType        String
  storageLocation String
  sizeBytes       Int      @default(0)
  provider        String   @default("local")
  metadata        String?  // JSON metadata
  createdAt       DateTime @default(now())

  @@index([projectId])
  @@index([assetType])
}

model Agent {
  id              String         @id @default(uuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String         @default("ContentSpine Knowledge Agent")
  instructions    String
  voiceId         String?
  language        String         @default("en-US")
  guardrails      String         // JSON guardrail settings (source-only, PII filter)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sessions        AgentSession[]
  tests           AgentTest[]

  @@index([projectId])
}

model AgentSession {
  id        String         @id @default(uuid())
  agentId   String
  agent     Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  messages  AgentMessage[]

  @@index([agentId])
}

model AgentMessage {
  id        String       @id @default(uuid())
  sessionId String
  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String       // USER, ASSISTANT, SYSTEM
  content   String
  audioUrl  String?
  toolCalls String?      // JSON trace of tools called
  createdAt DateTime     @default(now())

  @@index([sessionId])
}

model AgentTest {
  id          String   @id @default(uuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  inputQuery  String
  expectedAns String
  actualAns   String
  passed      Boolean
  createdAt   DateTime @default(now())

  @@index([agentId])
}

// ----------------------------------------------------
// RESUME INTELLIGENCE & ATS ENGINE MODELS
// ----------------------------------------------------

model Resume {
  id                    String            @id @default(uuid())
  userId                String?
  user                  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId             String?
  project               Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title                 String
  targetRole            String?
  candidateContentSpine String            // Stringified JSON Candidate Content Spine
  contactInfo           String?           // Stringified JSON Contact Info
  template              String            @default("ATS_CLASSIC")
  atsSafe               Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  versions              ResumeVersion[]
  atsScans              ATSScan[]
  coverLetters          CoverLetter[]
  linkedInProfiles      LinkedInProfile[]

  @@index([userId])
  @@index([projectId])
}

model ResumeVersion {
  id               String          @id @default(uuid())
  resumeId         String
  resume           Resume          @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  version          Int             @default(1)
  versionName      String          @default("Version 1")
  targetJobTitle   String?
  targetCompany    String?
  jobDescriptionId String?
  jobDescription   JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  atsScore         Float           @default(0.0)
  scoreBreakdown   String?         // Stringified JSON ATS breakdown
  optimizedContent String          // Stringified JSON optimized resume structure
  changesSummary   String?         // JSON list of bullet / section changes
  createdAt        DateTime        @default(now())
  atsScans         ATSScan[]

  @@index([resumeId])
  @@index([jobDescriptionId])
}

model JobDescription {
  id               String          @id @default(uuid())
  title            String
  company          String?
  rawText          String
  parsedJobSpine   String          // Stringified JSON Job Content Spine
  requiredSkills   String?         // Stringified JSON array
  preferredSkills  String?         // Stringified JSON array
  keywords         String?         // Stringified JSON array
  createdAt        DateTime        @default(now())
  resumeVersions   ResumeVersion[]
  atsScans         ATSScan[]
}

model ATSScan {
  id                   String          @id @default(uuid())
  resumeId             String
  resume               Resume          @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeVersionId      String?
  resumeVersion        ResumeVersion?  @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  jobDescriptionId     String?
  jobDescription       JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  overallScore         Float           @default(0.0)
  keywordMatchScore    Float           @default(0.0)
  skillsMatchScore     Float           @default(0.0)
  experienceMatchScore Float           @default(0.0)
  educationMatchScore  Float           @default(0.0)
  structureScore       Float           @default(0.0)
  formattingScore      Float           @default(0.0)
  contactInfoScore     Float           @default(0.0)
  contentQualityScore  Float           @default(0.0)
  findings             String          // Stringified JSON list of findings & penalties
  missingKeywords      String          // Stringified JSON list of missing keywords
  keywordTable         String          // Stringified JSON matrix (Keyword, Status, Evidence)
  createdAt            DateTime        @default(now())

  @@index([resumeId])
  @@index([resumeVersionId])
  @@index([jobDescriptionId])
}

model CoverLetter {
  id             String    @id @default(uuid())
  resumeId       String
  resume         Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  targetJobTitle String
  targetCompany  String
  content        String
  createdAt      DateTime  @default(now())

  @@index([resumeId])
}

model LinkedInProfile {
  id                   String   @id @default(uuid())
  resumeId             String
  resume               Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  headline             String
  aboutSummary         String
  experienceHighlights String   // Stringified JSON array
  skills               String   // Stringified JSON array
  createdAt            DateTime @default(now())

  @@index([resumeId])
}

